{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["./.cloudflare/types/index.d.ts", "vite/client", "node"],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": ["src", "cloudflare.config.ts", "vite.config.ts", ".cloudflare/types"]
}
