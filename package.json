{
  "name": "zus-randomizer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "cf dev",
    "build": "cf build",
    "deploy": "cf deploy",
    "typecheck": "pnpm run cf-typegen && tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "cf-typegen": "cf workers types",
    "fetch-outlets": "node scripts/fetch-outlets.mjs",
    "fetch-transit": "node scripts/fetch-transit.mjs",
    "fetch-outlets:luckin": "node scripts/fetch-luckin-outlets.mjs",
    "fetch-outlets:cbtl": "node scripts/fetch-cbtl-outlets.mjs",
    "fetch-outlets:sf": "node scripts/fetch-sf-outlets.mjs",
    "fetch-outlets:all": "pnpm fetch-outlets && pnpm fetch-outlets:luckin && pnpm fetch-outlets:cbtl && pnpm fetch-outlets:sf",
    "check-outlets": "node scripts/check-outlets.mjs",
    "classify-outlets": "node scripts/classify-outlets.mjs",
    "test:locations": "node --test scripts/outlet-locations.test.mjs",
    "test": "vitest run",
    "test:seo": "node scripts/check-seo.mjs --worker .cloudflare/output/v0/workers/default/bundle/index.js"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "canvas-confetti": "^1.9.4",
    "cf": "1.0.0-beta.14",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
