{
  "name": "zus-randomizer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "cf dev",
    "build": "cf build",
    "build:assets": "pnpm run build:css && pnpm run build:vendor",
    "build:css": "tailwindcss -i ./src/style.css -o ./public/style.css --minify",
    "build:vendor": "mkdir -p public/vendor && cp node_modules/canvas-confetti/dist/confetti.browser.js public/vendor/confetti.js",
    "deploy": "cf deploy",
    "typecheck": "pnpm run cf-typegen && tsc --noEmit",
    "cf-typegen": "cf workers types",
    "fetch-outlets": "node scripts/fetch-outlets.mjs",
    "fetch-transit": "node scripts/fetch-transit.mjs",
    "fetch-outlets:luckin": "node scripts/fetch-luckin-outlets.mjs",
    "fetch-outlets:cbtl": "node scripts/fetch-cbtl-outlets.mjs",
    "fetch-outlets:sf": "node scripts/fetch-sf-outlets.mjs",
    "fetch-outlets:all": "pnpm fetch-outlets && pnpm fetch-outlets:luckin && pnpm fetch-outlets:cbtl && pnpm fetch-outlets:sf",
    "check-outlets": "node scripts/check-outlets.mjs",
    "classify-outlets": "node scripts/classify-outlets.mjs",
    "test:locations": "node --test scripts/outlet-locations.test.mjs"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "canvas-confetti": "^1.9.4",
    "cf": "1.0.0-beta.14",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.149.0"
  }
}
