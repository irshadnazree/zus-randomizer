{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zus-randomizer",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "pnpm run build"
  },
  "assets": {
    "directory": "./public"
  },
  "routes": [
    { "pattern": "zus.ruxera.com", "custom_domain": true }
  ],
  // Production only: no *.workers.dev URL and no per-version preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  }
}
